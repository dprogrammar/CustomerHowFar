# Copy this file to .env.local and fill in the values.
# Never commit real secrets. .env and .env.local are git-ignored.

# Public base URL of the site, used for every absolute link (canonical tags, sitemap, Open Graph,
# emails). No trailing slash. Production: https://www.customerhowfar.com.ng
# Local development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Authentication secret
AUTH_SECRET=

# Supabase: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Supabase: Connect > connection strings
# Transaction pooler (port 6543), used by the app at runtime
DATABASE_URL=
# Session pooler (port 5432), used by Prisma migrations
DIRECT_URL=

# Cloudinary: Console > Settings > API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_CLOUD_NAME=
# The API key is public (sent to the browser with each upload signature).
CLOUDINARY_API_KEY=
# Server-only. Never expose to the browser.
CLOUDINARY_API_SECRET=

# Brevo transactional email (Brevo > SMTP & API > API keys). Server-only.
BREVO_API_KEY=
# Sender must be a verified sender/domain in Brevo.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Receives "listing submitted for review" notifications.
ADMIN_NOTIFY_EMAIL=
# TEST ONLY. When set to a file path, emails are written there instead of being sent.
# Never set this in production.
# EMAIL_TEST_OUTBOX=

# Vercel Cron: protects /api/cron/* (Vercel sends it as a Bearer token). Use a long random
# value, at least 16 characters, e.g. from: openssl rand -hex 32
CRON_SECRET=

# Error monitoring (Sentry). Optional: without it, errors are only logged.
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for readable stack traces: upload source maps at build time. If SENTRY_AUTH_TOKEN
# is not set, the upload is skipped and the build still succeeds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Web Push notifications (standard Web Push API with VAPID keys; free, no push service account).
# Generate once with: npx web-push generate-vapid-keys
# Keep the private key secret (server only). Without these, in-app and email notifications still work.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dprogrammar@gmail.com
