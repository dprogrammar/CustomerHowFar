# Copy this file to .env.local and fill in the values.
# Never commit real secrets. .env and .env.local are git-ignored.

# Public base URL of the site (e.g. http://localhost:3000)
NEXT_PUBLIC_SITE_URL=

# Authentication secret
AUTH_SECRET=

# Supabase: Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses Row Level Security. Never expose to the browser.
SUPABASE_SECRET_KEY=

# Supabase: Connect > connection strings
# Transaction pooler (port 6543), used by the app at runtime
DATABASE_URL=
# Session pooler (port 5432), used by Prisma migrations
DIRECT_URL=
