// Prisma schema for CustomerHowFar.
// Connection URLs live in prisma7.config.ts (CLI) and src/lib/prisma.ts (app), not here.
// Conventions: snake_case tables/columns via @map, UUIDv7 primary keys (time-ordered, index
// friendly) for user-generated rows, integer keys for small reference tables, money in kobo.
// See docs/DATA_MODEL.md for the model overview and the business status flow.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Settings and users
// ---------------------------------------------------------------------------

/// Global, admin-controlled settings. Holds a single row (id = 1).
model AppSetting {
  id                    Int      @id @default(1)
  /// Admin switch: when true, businesses must pay the listing fee to publish a listing.
  paymentRequired       Boolean  @default(false) @map("payment_required")
  /// Listing fee in whole Naira.
  listingFeeNaira       Int      @default(5000) @map("listing_fee_naira")
  /// Payment method: direct bank transfer with proof upload, confirmed manually by an admin.
  manualTransferEnabled Boolean  @default(false) @map("manual_transfer_enabled")
  /// Bank account shown to owners paying by transfer. Set by an admin (seeded once).
  bankName              String?  @map("bank_name")
  /// Exactly 10 digits (NUBAN).
  bankAccountNumber     String?  @map("bank_account_number") @db.VarChar(10)
  bankAccountName       String?  @map("bank_account_name")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  ADMIN

  @@map("role")
}

/// ACTIVE: normal. SUSPENDED: blocked by an admin (login banned in Supabase Auth, businesses
/// hidden). DELETED: an anonymized placeholder kept only because payment records point to it.
enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@map("user_status")
}

/// App profile for a Supabase Auth user. Created on first successful sign-in.
model Profile {
  /// Same UUID as the Supabase auth user (auth.users.id).
  id               String     @id @db.Uuid
  fullName         String     @map("full_name")
  email            String     @unique
  phone            String?
  avatarUrl        String?    @map("avatar_url")
  role             Role       @default(CUSTOMER)
  status           UserStatus @default(ACTIVE)
  /// Set while SUSPENDED (shown to admins; emailed to the user).
  suspensionReason String?    @map("suspension_reason")
  suspendedAt      DateTime?  @map("suspended_at")
  /// When the account was deleted (status DELETED; all personal data removed).
  deletedAt        DateTime?  @map("deleted_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  businesses            Business[]
  payments              Payment[]                @relation("PaymentUser")
  /// Payments this user confirmed or rejected as an admin.
  reviewedPayments      Payment[]                @relation("PaymentReviewer")
  /// Identity checks this user submitted (history kept).
  identityVerifications IdentityVerification[]   @relation("IdentitySubject")
  /// Identity checks this user reviewed as an admin.
  reviewedIdentities    IdentityVerification[]   @relation("IdentityReviewer")
  reviews               Review[]
  savedBusinesses       SavedBusiness[]
  contactEvents         ContactEvent[]
  /// Moderation decisions this user made as an admin.
  moderationDecisions   ModerationDecision[]
  /// Settings changes this user made as an admin.
  settingChanges        SettingChange[]
  /// Admin actions this user performed (audit log).
  auditEntries          AdminAuditLog[]
  reviewReports         ReviewReport[]           @relation("ReviewReporter")
  resolvedReviewReports ReviewReport[]           @relation("ReviewReportResolver")
  businessReports       BusinessReport[]         @relation("BusinessReporter")
  waitlistEntries       WaitlistEntry[]
  notifications         Notification[]
  pushSubscriptions     PushSubscription[]
  notificationPrefs     NotificationPreference[]
  ratingReminders       RatingReminder[]
  resolvedBizReports    BusinessReport[]         @relation("BusinessReportResolver")

  @@index([status, createdAt(sort: Desc)])
  @@index([role])
  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Reference data: categories and locations
// ---------------------------------------------------------------------------

/// Service category. Top-level when parentId is null; otherwise a subcategory.
model Category {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String
  /// URL identifier. Never change once live (used in links and SEO).
  slug        String   @unique
  /// lucide-react icon name, resolved through src/config/category-icons.ts.
  icon        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  parentId    String?  @map("parent_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// Deleting a parent that still has subcategories is blocked.
  parent     Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children   Category[] @relation("CategoryTree")
  businesses Business[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

/// The 36 states plus the FCT.
/// The 36 states plus the FCT. CustomerHowFar launches one state at a time: businesses can only
/// list (and be approved) in ACTIVE states; customers can browse everywhere. At least one state
/// is always active (enforced by a database trigger).
model State {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  slug       String    @unique
  /// Open for new business listings ("Live"); false = "Coming soon".
  isActive   Boolean   @default(false) @map("is_active")
  /// When the state was (last) switched on.
  launchedAt DateTime? @map("launched_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  lgas       Lga[]
  businesses Business[]
  waitlist   WaitlistEntry[]

  @@map("states")
}

/// Local Government Area (774 in total). Names repeat across states (e.g. Surulere in
/// Lagos and Oyo), so slugs are unique per state, not globally.
model Lga {
  id        Int      @id @default(autoincrement())
  stateId   Int      @map("state_id")
  name      String
  slug      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  state      State      @relation(fields: [stateId], references: [id], onDelete: Restrict)
  businesses Business[]

  @@unique([stateId, slug])
  /// Target of Business's composite foreign key, guaranteeing a business's LGA is in its state.
  @@unique([id, stateId])
  @@map("lgas")
}

// ---------------------------------------------------------------------------
// Marketplace
// ---------------------------------------------------------------------------

/// Lifecycle: DRAFT -> (PENDING_PAYMENT if payment is required) -> PENDING_REVIEW ->
/// APPROVED | REJECTED. Admins can SUSPEND an approved business. DELETED: soft-deleted because
/// payments exist; only the name and payment rows are kept, for accounting.
enum BusinessStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  DELETED

  @@map("business_status")
}

model Business {
  id                         String                   @id @default(uuid(7)) @db.Uuid
  ownerId                    String                   @map("owner_id") @db.Uuid
  name                       String
  /// URL identifier. Unique across the site.
  slug                       String                   @unique
  categoryId                 String                   @map("category_id") @db.Uuid
  tagline                    String?                  @db.VarChar(120)
  description                String?
  yearsOfExperience          Int?                     @map("years_of_experience") @db.SmallInt
  /// Nigerian numbers stored in E.164 form: +234XXXXXXXXXX.
  phone                      String
  whatsappNumber             String                   @map("whatsapp_number")
  email                      String?
  /// Location fields are filled in wizard step 2, so they are empty on early drafts.
  /// Submitting for review requires all of them.
  address                    String?
  /// Area or landmark, e.g. "Opposite Shoprite, Lekki Phase 1".
  area                       String?
  stateId                    Int?                     @map("state_id")
  lgaId                      Int?                     @map("lga_id")
  services                   String[]                 @default([])
  /// { mon: { open: "08:00", close: "18:00" } | null, ... }. Validated in app code.
  openingHours               Json?                    @map("opening_hours")
  instagramUrl               String?                  @map("instagram_url")
  facebookUrl                String?                  @map("facebook_url")
  tiktokUrl                  String?                  @map("tiktok_url")
  websiteUrl                 String?                  @map("website_url")
  /// Cloudinary public IDs.
  logoPublicId               String?                  @map("logo_public_id")
  coverPublicId              String?                  @map("cover_public_id")
  status                     BusinessStatus           @default(DRAFT)
  rejectionReason            String?                  @map("rejection_reason")
  /// Deprecated: no longer used or shown. The public badge comes from the owner's ID check.
  isVerified                 Boolean                  @default(false) @map("is_verified")
  isFeatured                 Boolean                  @default(false) @map("is_featured")
  /// Denormalized counters, updated by app code (reviews and contact events are the source).
  viewCount                  Int                      @default(0) @map("view_count")
  contactClickCount          Int                      @default(0) @map("contact_click_count")
  ratingAverage              Decimal                  @default(0) @map("rating_average") @db.Decimal(3, 2)
  reviewCount                Int                      @default(0) @map("review_count")
  /// First time the business was approved and shown publicly.
  publishedAt                DateTime?                @map("published_at")
  /// Last time the owner sent the listing for review (the admin queue is ordered by this).
  submittedAt                DateTime?                @map("submitted_at")
  /// The owner edited a live listing; it stays live but an admin should look again.
  needsRecheck               Boolean                  @default(false) @map("needs_recheck")
  /// Whether the listing fee was switched on when this business was last submitted.
  /// Approval requires a successful payment only when this is true (fairness rule).
  feeRequiredAtSubmit        Boolean                  @default(false) @map("fee_required_at_submit")
  /// Set while the OWNER is suspended: the status to restore when the owner is unsuspended.
  statusBeforeUserSuspension BusinessStatus?          @map("status_before_user_suspension")
  /// When the business was deleted (status DELETED).
  deletedAt                  DateTime?                @map("deleted_at")
  /// Search columns, maintained by a database trigger (see the public_search migration).
  /// Never written by app code. Short text for typo-tolerant trigram matching.
  searchText                 String?                  @map("search_text")
  /// Weighted full-text vector: name/category (A), services/tagline (B), description (C).
  searchVector               Unsupported("tsvector")? @map("search_vector")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")

  /// Deleting a profile deletes their businesses (unless payments exist, see Payment).
  owner               Profile              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Categories and locations in use cannot be deleted; deactivate them instead.
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  state               State?               @relation(fields: [stateId], references: [id], onDelete: Restrict)
  lga                 Lga?                 @relation(fields: [lgaId, stateId], references: [id, stateId], onDelete: Restrict)
  photos              BusinessPhoto[]
  payments            Payment[]
  reviews             Review[]
  savedBy             SavedBusiness[]
  contactEvents       ContactEvent[]
  moderationDecisions ModerationDecision[]
  reports             BusinessReport[]
  ratingReminders     RatingReminder[]

  // Public listings always filter by status, so status leads most composite indexes.
  @@index([status, createdAt(sort: Desc)])
  /// Admin review queue: PENDING_REVIEW ordered by submission time.
  @@index([status, submittedAt])
  /// Admin "edited since approval" queue.
  @@index([needsRecheck, status])
  /// Full-text search.
  @@index([searchVector], type: Gin, map: "businesses_search_vector_idx")
  /// Typo-tolerant (trigram) search. Requires the pg_trgm extension.
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "businesses_search_text_trgm_idx")
  /// Most viewed sort.
  @@index([status, viewCount(sort: Desc)])
  /// Newest sort.
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, isFeatured])
  @@index([categoryId, status])
  @@index([stateId, status])
  @@index([lgaId, stateId, status])
  @@index([ownerId])
  @@index([createdAt(sort: Desc)])
  @@map("businesses")
}

/// Work photos. At most 12 per business (enforced in app code).
model BusinessPhoto {
  id         String   @id @default(uuid(7)) @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  /// Cloudinary public ID.
  publicId   String   @unique @map("public_id")
  width      Int
  height     Int
  caption    String?  @db.VarChar(200)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sortOrder])
  @@map("business_photos")
}

/// PENDING: started, nothing reported yet. AWAITING_CONFIRMATION: bank transfer proof uploaded,
/// waiting for an admin. SUCCESS: money confirmed. FAILED: provider failure or proof rejected
/// (see rejectionReason). ABANDONED: cancelled.
enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  SUCCESS
  FAILED
  ABANDONED

  @@map("payment_status")
}

/// Payment method. Code for each lives in src/lib/payments/methods.
enum PaymentProvider {
  PAYSTACK
  MANUAL_TRANSFER

  @@map("payment_provider")
}

enum Currency {
  NGN

  @@map("currency")
}

/// Listing-fee payments. Financial records are never deleted: businesses and profiles with
/// payments cannot be hard-deleted (Restrict); suspend or anonymize them instead.
model Payment {
  id         String          @id @default(uuid(7)) @db.Uuid
  businessId String          @map("business_id") @db.Uuid
  userId     String          @map("user_id") @db.Uuid
  /// Amount in kobo (1 Naira = 100 kobo). Integers only, never floats.
  amountKobo Int             @map("amount_kobo")
  currency   Currency        @default(NGN)
  provider   PaymentProvider @default(PAYSTACK)
  /// Our reference sent to the provider; unique so webhooks are idempotent.
  reference  String          @unique
  status     PaymentStatus   @default(PENDING)
  paidAt     DateTime?       @map("paid_at")
  metadata   Json?

  // --- Manual bank transfer details (provider MANUAL_TRANSFER) ---
  /// Name on the account the owner sent the money from.
  senderName       String?   @map("sender_name")
  senderBank       String?   @map("sender_bank")
  /// What the owner says they sent, in kobo. Must be at least amountKobo to confirm.
  amountSentKobo   Int?      @map("amount_sent_kobo")
  transferDate     DateTime? @map("transfer_date") @db.Date
  /// Cloudinary public ID of the proof file. Stored as an AUTHENTICATED (private) asset;
  /// only admins can view it through short-lived signed URLs.
  proofPublicId    String?   @unique @map("proof_public_id")
  /// "pdf", "jpg", "png" or "webp".
  proofFormat      String?   @map("proof_format")
  proofSubmittedAt DateTime? @map("proof_submitted_at")
  /// Shown to the owner when an admin rejects a proof (status FAILED).
  rejectionReason  String?   @map("rejection_reason")
  /// Admin who confirmed or rejected the payment, and when.
  reviewedById     String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt       DateTime? @map("reviewed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  user       Profile  @relation("PaymentUser", fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy Profile? @relation("PaymentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  /// Admin queue of transfers to confirm (oldest first).
  @@index([status, proofSubmittedAt])
  @@index([reviewedById])
  @@map("payments")
}

enum ReviewStatus {
  PUBLISHED
  HIDDEN

  @@map("review_status")
}

/// One review per user per business. Rating 1-5 (enforced by a CHECK constraint). Only
/// PUBLISHED reviews count towards Business.ratingAverage / reviewCount (kept in sync in the
/// same transaction as every review change).
model Review {
  id           String       @id @default(uuid(7)) @db.Uuid
  businessId   String       @map("business_id") @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  rating       Int          @db.SmallInt
  comment      String?
  status       ReviewStatus @default(PUBLISHED)
  /// The business owner's single public reply.
  ownerReply   String?      @map("owner_reply")
  ownerReplyAt DateTime?    @map("owner_reply_at")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     Profile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports  ReviewReport[]

  @@unique([businessId, userId])
  @@index([businessId, status, createdAt(sort: Desc)])
  @@index([userId])
  @@map("reviews")
}

/// A user's saved (favourite) business.
model SavedBusiness {
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@index([businessId])
  @@map("saved_businesses")
}

enum ContactType {
  WHATSAPP
  CALL
  EMAIL

  @@map("contact_type")
}

/// Analytics: one row per contact click. High volume, so a bigint key.
model ContactEvent {
  id         BigInt      @id @default(autoincrement())
  businessId String      @map("business_id") @db.Uuid
  type       ContactType
  /// Null for signed-out visitors, or after the user's profile is deleted.
  userId     String?     @map("user_id") @db.Uuid
  createdAt  DateTime    @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("contact_events")
}

// ---------------------------------------------------------------------------
// Moderation
// ---------------------------------------------------------------------------

enum ModerationAction {
  APPROVED
  REJECTED
  SUSPENDED
  REINSTATED
  /// Admin reviewed an owner's edits to a live listing (needsRecheck cleared).
  RECHECKED
  VERIFIED
  UNVERIFIED
  FEATURED
  UNFEATURED

  @@map("moderation_action")
}

/// Append-only history of admin decisions on a business (the "review history").
/// Named ModerationDecision to avoid confusion with customer Reviews.
model ModerationDecision {
  id         String           @id @default(uuid(7)) @db.Uuid
  businessId String           @map("business_id") @db.Uuid
  /// Admin who decided. Null if that admin's profile was later deleted (history is kept).
  adminId    String?          @map("admin_id") @db.Uuid
  action     ModerationAction
  /// Shown to the owner for REJECTED ("Changes requested: ...") and SUSPENDED.
  comment    String?
  createdAt  DateTime         @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  admin    Profile? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt(sort: Desc)])
  @@index([adminId])
  @@map("moderation_decisions")
}

/// Audit log of admin changes to AppSetting (who changed what, and when).
model SettingChange {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Null if that admin's profile was later deleted (the log is kept).
  adminId   String?  @map("admin_id") @db.Uuid
  /// AppSetting field name, e.g. "paymentRequired" or "listingFeeNaira".
  field     String
  oldValue  String   @map("old_value")
  newValue  String   @map("new_value")
  createdAt DateTime @default(now()) @map("created_at")

  admin Profile? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([adminId])
  @@map("setting_changes")
}

// ---------------------------------------------------------------------------
// Identity verification (visual check of a government ID + selfie by an admin)
// ---------------------------------------------------------------------------

enum IdType {
  NIN_SLIP
  VOTERS_CARD
  DRIVERS_LICENCE
  INTERNATIONAL_PASSPORT

  @@map("id_type")
}

/// PENDING -> APPROVED | REJECTED by an admin. WITHDRAWN: the owner took it back.
/// SUPERSEDED: replaced by a newer submission. Images of WITHDRAWN/SUPERSEDED rows are deleted
/// immediately; others 90 days after the decision. The decision record itself is kept.
enum IdentityStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  SUPERSEDED

  @@map("identity_status")
}

/// One submission of an ID photo + selfie. At most one PENDING or APPROVED per user (partial
/// unique index in the migration). ID NUMBERS ARE NEVER COLLECTED OR STORED.
/// Images are private Cloudinary assets (customerhowfar/identity/<userId>/), viewable only by
/// admins through short-lived signed links.
model IdentityVerification {
  id              String         @id @default(uuid(7)) @db.Uuid
  /// Null after the user's account is deleted; the daily job then deletes the images and name.
  userId          String?        @map("user_id") @db.Uuid
  idType          IdType         @map("id_type")
  /// Full name exactly as typed by the user from their ID.
  fullNameOnId    String         @map("full_name_on_id")
  idFrontPublicId String?        @unique @map("id_front_public_id")
  idFrontFormat   String?        @map("id_front_format")
  idBackPublicId  String?        @unique @map("id_back_public_id")
  idBackFormat    String?        @map("id_back_format")
  selfiePublicId  String?        @unique @map("selfie_public_id")
  selfieFormat    String?        @map("selfie_format")
  consentGivenAt  DateTime       @map("consent_given_at")
  status          IdentityStatus @default(PENDING)
  /// Name the reviewing admin read on the ID (recorded when accepting).
  nameReadByAdmin String?        @map("name_read_by_admin")
  /// Shown to the owner when rejected.
  rejectionReason String?        @map("rejection_reason")
  reviewedById    String?        @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime?      @map("reviewed_at")
  submittedAt     DateTime       @default(now()) @map("submitted_at")
  /// When the ID and selfie images were deleted from storage.
  imagesDeletedAt DateTime?      @map("images_deleted_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user       Profile? @relation("IdentitySubject", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy Profile? @relation("IdentityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, submittedAt(sort: Desc)])
  /// Admin queue (oldest first).
  @@index([status, submittedAt])
  /// Retention job.
  @@index([imagesDeletedAt, reviewedAt])
  @@index([reviewedById])
  @@map("identity_verifications")
}

// ---------------------------------------------------------------------------
// Admin audit log and storage cleanup
// ---------------------------------------------------------------------------

enum AuditAction {
  USER_SUSPENDED
  USER_UNSUSPENDED
  USER_DELETED
  USER_SELF_DELETED
  USER_ROLE_CHANGED
  BUSINESS_DELETED
  BUSINESS_SELF_DELETED
  STATE_ACTIVATED
  STATE_DEACTIVATED
  WAITLIST_NOTIFIED
  REVIEW_HIDDEN
  REVIEW_RESTORED
  REVIEW_REPORTS_DISMISSED
  LISTING_REPORTS_DISMISSED
  LISTING_REPORTS_ACTIONED

  @@map("audit_action")
}

/// Append-only log of sensitive account actions. Holds no personal data: targets are ids
/// (pseudonymous once the user is deleted) and `summary` is non-personal (e.g. a role change or
/// a business name, which is kept for accounting anyway).
model AdminAuditLog {
  id               String      @id @default(uuid(7)) @db.Uuid
  /// Who did it (an admin, or the user themselves). Null if that profile was later deleted.
  actorId          String?     @map("actor_id") @db.Uuid
  action           AuditAction
  /// No foreign keys: the log outlives the user and business it refers to.
  targetUserId     String?     @map("target_user_id") @db.Uuid
  targetBusinessId String?     @map("target_business_id") @db.Uuid
  targetReviewId   String?     @map("target_review_id") @db.Uuid
  summary          String?
  reason           String?
  createdAt        DateTime    @default(now()) @map("created_at")

  actor Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt(sort: Desc)])
  @@index([targetBusinessId])
  @@index([actorId])
  @@index([createdAt(sort: Desc)])
  @@map("admin_audit_log")
}

/// Cloudinary files whose deletion failed after the database change committed. Retried by the
/// daily job until they are gone.
model PendingFileDeletion {
  id            String    @id @default(uuid(7)) @db.Uuid
  publicId      String    @unique @map("public_id")
  /// "upload" (public) or "authenticated" (private).
  deliveryType  String    @map("delivery_type")
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @map("last_attempt_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("pending_file_deletions")
}

// ---------------------------------------------------------------------------
// Reports and rate limits
// ---------------------------------------------------------------------------

enum ReportStatus {
  OPEN
  DISMISSED
  ACTIONED

  @@map("report_status")
}

enum ReviewReportReason {
  FAKE
  OFFENSIVE
  SPAM
  NOT_A_CUSTOMER

  @@map("review_report_reason")
}

/// A logged-in user's report of a review. At most one OPEN report per user per review
/// (partial unique index in the migration).
model ReviewReport {
  id           String             @id @default(uuid(7)) @db.Uuid
  reviewId     String             @map("review_id") @db.Uuid
  reporterId   String             @map("reporter_id") @db.Uuid
  reason       ReviewReportReason
  status       ReportStatus       @default(OPEN)
  resolvedById String?            @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?          @map("resolved_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  review     Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter   Profile  @relation("ReviewReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy Profile? @relation("ReviewReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reviewId, status])
  @@index([reporterId])
  @@index([resolvedById])
  @@map("review_reports")
}

enum ListingReportReason {
  SCAM
  FAKE_PHOTOS
  WRONG_CONTACT
  OFFENSIVE
  CLOSED
  OTHER

  @@map("listing_report_reason")
}

/// A logged-in user's report of a business listing. At most one OPEN report per user per
/// business (partial unique index in the migration). Details are required for OTHER.
model BusinessReport {
  id           String              @id @default(uuid(7)) @db.Uuid
  businessId   String              @map("business_id") @db.Uuid
  reporterId   String              @map("reporter_id") @db.Uuid
  reason       ListingReportReason
  details      String?
  status       ReportStatus        @default(OPEN)
  resolvedById String?             @map("resolved_by_id") @db.Uuid
  resolvedAt   DateTime?           @map("resolved_at")
  /// What the admin did, e.g. "Dismissed", "Listing suspended", "Owner suspended".
  resolution   String?
  createdAt    DateTime            @default(now()) @map("created_at")

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reporter   Profile  @relation("BusinessReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy Profile? @relation("BusinessReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([businessId, status])
  @@index([reporterId])
  @@index([resolvedById])
  @@map("business_reports")
}

/// One row per rate-limited action (e.g. a contact form message or a review). `key` is a
/// purpose plus a user id or a keyed hash of the IP address, never a raw IP. Old rows are
/// removed by the daily job.
model RateLimitHit {
  id        BigInt   @id @default(autoincrement())
  key       String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([key, createdAt])
  @@index([createdAt])
  @@map("rate_limit_hits")
}

/// Background job bookkeeping (e.g. the daily job), shown by /api/health. Counts only.
model JobRun {
  name           String    @id
  lastStartedAt  DateTime? @map("last_started_at")
  lastSuccessAt  DateTime? @map("last_success_at")
  lastFailureAt  DateTime? @map("last_failure_at")
  /// Error class name only (never messages, which could contain data).
  lastError      String?   @map("last_error")
  lastDurationMs Int?      @map("last_duration_ms")
  /// Counts from the last successful run.
  lastResult     Json?     @map("last_result")

  @@map("job_runs")
}

// ---------------------------------------------------------------------------
// Service areas: waitlist for states that aren't live yet
// ---------------------------------------------------------------------------

enum WaitlistRole {
  CUSTOMER
  BUSINESS

  @@map("waitlist_role")
}

/// Someone asking to be emailed when CustomerHowFar launches in a state. One entry per email
/// per state. Deleted with the user's account (by user id or email).
model WaitlistEntry {
  id               String       @id @default(uuid(7)) @db.Uuid
  /// Lowercased.
  email            String
  stateId          Int          @map("state_id")
  name             String?
  role             WaitlistRole
  /// Set when the person was logged in when joining.
  userId           String?      @map("user_id") @db.Uuid
  consentAt        DateTime     @map("consent_at")
  /// Random secret for the unsubscribe link (no login needed).
  unsubscribeToken String       @unique @map("unsubscribe_token")
  notifiedAt       DateTime?    @map("notified_at")
  unsubscribedAt   DateTime?    @map("unsubscribed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  state State    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  user  Profile? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([email, stateId])
  /// Waitlist counts and "email the waitlist" (not yet notified, still subscribed).
  @@index([stateId, notifiedAt, unsubscribedAt])
  @@index([userId])
  @@map("waitlist_entries")
}

// ---------------------------------------------------------------------------
// Help centre and the HowFar Assistant (free, rule-based help chat)
// ---------------------------------------------------------------------------

enum FaqCategory {
  CUSTOMERS
  SAFETY
  BUSINESSES
  ACCOUNT

  @@map("faq_category")
}

/// When a help entry is shown: always, or only while the listing fee switch is on/off.
enum FaqVisibility {
  ALWAYS
  FEE_ON
  FEE_OFF

  @@map("faq_visibility")
}

/// A help-centre question and answer. Shown on /help and used by the HowFar Assistant chat, so
/// both always say the same thing. Answers are simple markdown and may contain live-fact
/// placeholders (e.g. {{listing_fee}}) filled from the database when shown.
model FaqEntry {
  id              String                   @id @default(uuid(7)) @db.Uuid
  /// Anchor on /help (e.g. /help#listing-fee). Never change once live: links point to it.
  slug            String                   @unique
  question        String
  /// Paragraphs, "- " lists, **bold** and [links](/path). See src/lib/help/markdown.tsx.
  answer          String
  /// Other words and phrases people use for this question (synonyms, Pidgin), for matching.
  keywords        String[]                 @default([])
  category        FaqCategory
  isActive        Boolean                  @default(true) @map("is_active")
  /// Fee-related answers are shown only while the listing fee is on (AppSetting.paymentRequired);
  /// "free to list" answers only while it is off.
  visibility      FaqVisibility            @default(ALWAYS)
  sortOrder       Int                      @default(0) @map("sort_order")
  /// Chat statistics: times given as the answer, and "Did this help?" votes.
  timesShown      Int                      @default(0) @map("times_shown")
  helpfulCount    Int                      @default(0) @map("helpful_count")
  notHelpfulCount Int                      @default(0) @map("not_helpful_count")
  /// Search columns, maintained by a database trigger (see the help_assistant migration).
  /// Never written by app code.
  searchVector    Unsupported("tsvector")? @map("search_vector")
  /// Distinct words of the question and keywords, for typo-tolerant (trigram) matching.
  matchTerms      String[]                 @default([]) @map("match_terms")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  @@index([isActive, category, sortOrder])
  @@index([searchVector], type: Gin, map: "faq_entries_search_vector_idx")
  @@map("faq_entries")
}

/// A question the assistant couldn't answer, kept ANONYMOUSLY to improve help content: emails,
/// phone numbers, long numbers and names are removed first, and nothing links it to a person
/// (no user id, no IP, a random v4 id, and the day only, never the time). Deleted after 180 days.
model UnansweredQuestion {
  id      String   @id @default(uuid()) @db.Uuid
  text    String   @db.VarChar(200)
  askedOn DateTime @map("asked_on") @db.Date

  @@index([askedOn])
  @@map("unanswered_questions")
}

// ---------------------------------------------------------------------------
// Notifications: in-app notification centre, Web Push and per-category preferences
// ---------------------------------------------------------------------------

/// Groups of notifications people can switch push and email on or off for.
enum NotificationCategory {
  /// Listing approved, changes requested, suspended, reinstated, ID check results.
  LISTING
  /// Payment proof received, confirmed or rejected.
  PAYMENT
  /// New reviews (owners) and owner replies to your review (customers).
  REVIEW
  /// "Did you hire ...? Rate them" follow-ups after contacting a business.
  RATING_REMINDER
  /// A state you're waiting for goes live.
  STATE_LAUNCH
  /// New listings, transfer proofs, ID checks and reports (admins only).
  ADMIN

  @@map("notification_category")
}

/// In-app notification (the bell). Always created; push and email follow the user's preferences.
/// Holds only what the user may see: never bank details, ID information or other people's full
/// names. Deleted after 90 days by the daily job.
model Notification {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  /// Event name, e.g. "listing-approved".
  type      String               @db.VarChar(60)
  title     String               @db.VarChar(120)
  body      String               @db.VarChar(300)
  /// Site path opened on click, e.g. /dashboard.
  link      String               @db.VarChar(300)
  readAt    DateTime?            @map("read_at")
  createdAt DateTime             @default(now()) @map("created_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The bell: newest first per user.
  @@index([userId, createdAt(sort: Desc)])
  /// Unread count.
  @@index([userId, readAt])
  /// 90-day clean-up.
  @@index([createdAt])
  @@map("notifications")
}

/// A browser/device that turned on push (standard Web Push API with VAPID keys; no paid push
/// service). Removed when the push service reports it expired (404/410) or the user removes it.
model PushSubscription {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// The browser vendor's push endpoint (allow-listed hosts only).
  endpoint   String    @unique
  p256dh     String
  auth       String
  /// Readable device label, e.g. "Chrome on Android".
  label      String    @db.VarChar(80)
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Per-category push/email choice. No row means both are on (the defaults).
model NotificationPreference {
  userId   String               @map("user_id") @db.Uuid
  category NotificationCategory
  push     Boolean              @default(true)
  email    Boolean              @default(true)

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
  @@map("notification_preferences")
}

/// "Did you hire ...? Rate them" was sent for this customer and business (once only).
model RatingReminder {
  userId     String   @map("user_id") @db.Uuid
  businessId String   @map("business_id") @db.Uuid
  sentAt     DateTime @default(now()) @map("sent_at")

  user     Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
  @@index([businessId])
  @@map("rating_reminders")
}
