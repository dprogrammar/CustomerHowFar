// Prisma schema for CustomerHowFar.
// Connection URLs live in prisma7.config.ts (CLI) and src/lib/prisma.ts (app), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Global, admin-controlled settings. Holds a single row (id = 1).
model AppSetting {
  id              Int      @id @default(1)
  /// Admin switch: when true, businesses must pay the listing fee to publish a listing.
  paymentRequired Boolean  @default(false) @map("payment_required")
  /// Listing fee in whole Naira.
  listingFeeNaira Int      @default(5000) @map("listing_fee_naira")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

enum Role {
  CUSTOMER
  BUSINESS_OWNER
  ADMIN

  @@map("role")
}

/// App profile for a Supabase Auth user. Created on first successful sign-in.
model Profile {
  /// Same UUID as the Supabase auth user (auth.users.id).
  id        String   @id @db.Uuid
  fullName  String   @map("full_name")
  email     String   @unique
  phone     String?
  avatarUrl String?  @map("avatar_url")
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}
